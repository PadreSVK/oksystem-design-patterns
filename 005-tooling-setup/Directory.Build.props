<Project>

  <PropertyGroup>
    <!--
      Step 1 complete — these settings apply to every project under hands-on/.
      AnalysisMode=All  : enables all built-in .NET quality analyzers (CA rules).
      Nullable=enable   : turns on nullable reference type analysis.
    -->
    <AnalysisMode>All</AnalysisMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Uncomment for CI strictness (stretch goal / step 7):
      Fails the build on any analyzer warning when the CI environment variable is set.
    -->
    <!-- <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors> -->
  </PropertyGroup>

  <!--
    ============================================================
    TODO Step 3 — Add StyleCop.Analyzers and Roslynator.Analyzers
