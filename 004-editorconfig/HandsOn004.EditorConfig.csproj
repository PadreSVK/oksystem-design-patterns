<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/overview?tabs=net-10#enable-on-build -->
  </PropertyGroup>

  <!-- Exclude solution files — they conflict with the entry-point top-level statements -->
  <ItemGroup>
    <Compile Remove="*-Solution.cs" />
  </ItemGroup>

</Project>
